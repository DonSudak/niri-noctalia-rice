#!/usr/bin/env python3
"""Generate ~/.config/niri/cfg/display.kdl from the outputs niri currently sees.
Per output: highest refresh rate at the preferred resolution, VRR on-demand, scale from physical DPI,
laid out left-to-right by connector name. Skipped if display.kdl lacks the AUTOGEN marker (hand-edited = frozen).
Run at niri startup; niri live-reloads the include when the file changes. Rotation isn't detectable: edit and drop the marker."""
import glob, json, os, subprocess, sys

MARK = "// AUTOGEN niri-autodisplay (delete this line to freeze the file)"
path = os.path.expanduser("~/.config/niri/cfg/display.kdl")

if os.path.exists(path) and MARK not in open(path).read():
    sys.exit(0)
if "NIRI_SOCKET" not in os.environ:
    socks = glob.glob(f"/run/user/{os.getuid()}/niri.*.sock")
    if not socks:
        sys.exit("no niri session")
    os.environ["NIRI_SOCKET"] = socks[0]

outs = json.loads(subprocess.check_output(["niri", "msg", "--json", "outputs"]))
lines, x = [MARK], 0
for name in sorted(outs):
    o = outs[name]
    pref = next((m for m in o["modes"] if m["is_preferred"]), o["modes"][0])
    best = max((m for m in o["modes"] if (m["width"], m["height"]) == (pref["width"], pref["height"])),
               key=lambda m: m["refresh_rate"])
    w_mm = o["physical_size"][0] if o.get("physical_size") else 0
    dpi = best["width"] / (w_mm / 25.4) if w_mm else 96
    scale = 2.0 if dpi >= 200 else 1.5 if dpi >= 150 else 1.0
    lines += [f'output "{name}" {{',
              f'    mode "{best["width"]}x{best["height"]}@{best["refresh_rate"] / 1000:.3f}"',
              f'    scale {scale}',
              f'    position x={x} y=0']
    if o.get("vrr_supported"):
        lines.append("    variable-refresh-rate on-demand=true")
    lines.append("}")
    x += int(best["width"] / scale)
new = "\n".join(lines) + "\n"
if not os.path.exists(path) or open(path).read() != new:
    open(path, "w").write(new)
